    "express": "4.21.0",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-redux": "9.1.2",
    "react-router-dom": "6.26.2",
    "styled-components": "6.1.13"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.2",
    "vite": "5.4.8"
  }
}
